# Beszel agent configuration for the Magisk module.
# Copy to .env (or edit the one created on install) and fill in your values.
# File location after install: /data/adb/modules/beszel-agent/.env

# Public key shown when adding a system in the Hub
KEY=ssh-ed25519 AAAA...your-public-key...

# Agent token (from Hub /settings/tokens or the add-system dialog)
TOKEN=your-token-here

# Hub base URL (include scheme and port)
HUB_URL=http://127.0.0.1:8090

# Optional: path used for root filesystem / disk I/O stats (default: /data)
# FILESYSTEM=/data

# Optional: persistent agent state dir (fingerprint). Default:
#   /data/adb/modules/beszel-agent/data
# Must be writable and survive reboot. Do NOT use /var/lib on Android.
# DATA_DIR=/data/adb/modules/beszel-agent/data
