# Beszel agent configuration for the Magisk module.
# 
# FIRST INSTALLATION:
# Place this file as 'beszel.txt' in your internal storage (/sdcard/)
# before installing the module. The installer will automatically copy it.
#
# File location after install: /data/adb/beszel-agent/.env

# Public key shown when adding a system in the Hub
KEY=ssh-ed25519 AAAA...

# Agent token (from Hub /settings/tokens or the add-system dialog)
TOKEN=your-token

# Hub base URL (include scheme and port)
HUB_URL=http://your-hub:8090

# Optional: override system name (auto-detected if not set)
# SYSTEM_NAME=My Android Device

# Optional: path used for root filesystem / disk I/O stats (default: /data)
# FILESYSTEM=/data

# Optional: persistent agent state dir (fingerprint)
# DATA_DIR=/data/adb/beszel-agent/data